local function getSoundPartPos(sound)
	local Parent = sound.Parent
	if Parent and Parent:IsA("BasePart") then
		return Parent.Position, Parent
	elseif Parent and Parent:IsA("Attachment") and Parent.Parent and Parent.Parent:IsA("BasePart") then
		return Parent.Parent.Position, Parent.Parent
	else
		local BasePart = sound:FindFirstAncestorWhichIsA("BasePart")
		if BasePart then
			return BasePart.Position, BasePart
		end
	end
	return nil, nil
end


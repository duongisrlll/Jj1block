local function makeDraggableFrame(guiObj)
	local dragging = false
	local dragStart = Vector2.zero
	local startPos = guiObj.Position

	guiObj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = guiObj.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			guiObj.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local function attachDragAndToggle(btn, onToggle)
	local dragging = false
	local movedFar = false
	local detached = false
	local dragStart = Vector2.zero
	local startPos = btn.Position
	local lastTrigger = 0

	local function fireTap()
		local now = os.clock()
		if now - lastTrigger < 0.12 then
			return
		end
		lastTrigger = now
		if onToggle then
			onToggle()
		end
	end

	local function detachFree()
		if detached then
			return
		end
		detached = true
		local absPos = btn.AbsolutePosition
		local absSize = btn.AbsoluteSize
		btn.Parent = overlayGui
		btn.Size = UDim2.new(0, absSize.X > 0 and absSize.X or 128, 0, absSize.Y > 0 and absSize.Y or 34)
		btn.Position = UDim2.new(0, absPos.X, 0, absPos.Y)
		startPos = btn.Position
	end

	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			movedFar = false
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = btn.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			if delta.Magnitude > 8 then
				movedFar = true
				detachFree()
				btn.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			local shouldToggle = not movedFar
			dragging = false
			if shouldToggle then
				fireTap()
			end
		end
	end)

	btn.Activated:Connect(function()
		if not movedFar then
			fireTap()
		end
	end)
end


local function makeDraggable(guiObj, onTap)
	local dragging = false
	local moved = false
	local dragInput, dragStart, startPos

	guiObj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = guiObj.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					local wasTap = dragging and not moved
					dragging = false
					if wasTap and onTap then
						onTap()
					end
				end
			end)
		end
	end)

	guiObj.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	RunService.RenderStepped:Connect(function()
		if dragging and dragInput and overlayGui.Parent then
			local delta = dragInput.Position - dragStart
			if delta.Magnitude > 6 then
				moved = true
			end
			if moved then
				guiObj.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			end
		end
	end)
end

